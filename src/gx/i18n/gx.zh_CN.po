# Ghostty GX user interface translations (zh_CN).
#
# Entries here override po/zh_CN.po in the generated table
# src/gx/i18n/zh_CN.zig. Regenerate after every change with
# `python scripts/gx_i18n.py`; `python scripts/gx_i18n.py --check` fails
# when the table is stale. Placeholders such as {name} must appear in
# msgstr exactly as in msgid. Strings already translated upstream are
# repeated here (with the upstream wording) so the Ghostty GX UIs keep
# working when upstream edits or drops them.
msgid ""
msgstr ""
"Project-Id-Version: ghostty-gx\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

