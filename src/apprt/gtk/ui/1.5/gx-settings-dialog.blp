using Gtk 4.0;
using Adw 1;

template $GhosttyGxSettingsDialog: Adw.PreferencesDialog {
  // The Ghostty GX settings dialog (src/apprt/gtk/gx/settings_dialog.zig).
  // Its text comes from the Ghostty GX translation tables at runtime, so
  // nothing here is marked for gettext. Wide enough that the page switcher
  // of six pages stays in the header bar: libadwaita 1.5 moves it to the
  // bottom below 110 pt per page (about 880 px). The root carries
  // gx-dialog for the GX dialog styles (src/apprt/gtk/gx/style.css).
  content-width: 920;
  content-height: 680;
  search-enabled: false;
  close-attempt => $close_attempted();
  closed => $closed();
  notify::visible-page => $page_changed();

  styles [
    "gx-dialog",
  ]

  Adw.PreferencesPage language_page {
    name: "language";
    icon-name: "preferences-desktop-locale-symbolic";

    Adw.PreferencesGroup language_group {
      Adw.ComboRow language_row {
        notify::selected => $language_selected();
      }
    }
  }

  Adw.PreferencesPage appearance_page {
    name: "appearance";
    icon-name: "preferences-desktop-appearance-symbolic";

    Adw.PreferencesGroup theme_group {
      Adw.ActionRow theme_row {
        activatable: true;
        use-markup: false;
        activated => $theme_row_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }

      Adw.ActionRow theme_light_row {
        visible: false;
        activatable: true;
        use-markup: false;
        activated => $theme_row_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }

      Adw.ActionRow theme_dark_row {
        visible: false;
        activatable: true;
        use-markup: false;
        activated => $theme_row_activated();

        [suffix]
        Gtk.Image {
          icon-name: "go-next-symbolic";
        }
      }
    }

    Adw.PreferencesGroup accent_group {
      Adw.ComboRow accent_row {
        notify::selected => $accent_selected();
      }

      // A color of its own (`gx-accent-color = #rrggbb`) is not a choice:
      // the row shows it read-only, until "Reset to Default" when the
      // settings file has it.
      Adw.ActionRow accent_custom_row {
        visible: false;
        use-markup: false;

        [suffix]
        Gtk.Image {
          icon-name: "changes-prevent-symbolic";

          styles [
            "dim-label",
          ]
        }

        [suffix]
        Gtk.Label accent_custom_label {
          styles [
            "dim-label",
          ]
        }

        [suffix]
        Gtk.Button accent_reset_button {
          visible: false;
          icon-name: "edit-undo-symbolic";
          valign: center;
          clicked => $accent_reset_clicked();

          styles [
            "flat",
          ]
        }
      }
    }

    Adw.PreferencesGroup material_group {
      Adw.ComboRow material_row {
        notify::selected => $material_selected();
      }

      Adw.ComboRow opacity_row {
        notify::selected => $opacity_selected();
      }
    }

    Adw.PreferencesGroup cursor_group {
      Adw.ComboRow cursor_style_row {
        notify::selected => $cursor_style_selected();
      }

      Adw.SwitchRow cursor_blink_row {
        notify::active => $cursor_blink_toggled();
      }
    }

    Adw.PreferencesGroup padding_group {
      Adw.ComboRow padding_row {
        notify::selected => $padding_selected();
      }
    }
  }

  Adw.PreferencesPage font_page {
    name: "font";
    icon-name: "preferences-desktop-font-symbolic";

    Adw.PreferencesGroup font_size_group {
      Adw.SpinRow font_size_row {
        digits: 1;
        numeric: true;

        adjustment: Gtk.Adjustment {
          lower: 6;
          upper: 100;
          step-increment: 0.5;
          page-increment: 2;
        };

        notify::value => $font_size_changed();
        output => $font_size_output();

        [suffix]
        Gtk.Button font_size_reset_button {
          icon-name: "edit-undo-symbolic";
          valign: center;
          clicked => $font_size_reset_clicked();

          styles [
            "flat",
          ]
        }
      }
    }

    Adw.PreferencesGroup font_family_group {
      Adw.ActionRow font_choice_row {
        [suffix]
        Gtk.FontDialogButton font_choose_button {
          level: family;
          use-font: false;
          use-size: false;
          valign: center;
          notify::font-desc => $font_family_selected();
        }

        [suffix]
        Gtk.Button font_clear_button {
          icon-name: "edit-clear-symbolic";
          valign: center;
          clicked => $font_clear_clicked();

          styles [
            "flat",
          ]
        }
      }

      Adw.EntryRow font_family_row {
        show-apply-button: true;
        apply => $font_family_applied();
      }
    }
  }

  Adw.PreferencesPage interaction_page {
    name: "interaction";
    icon-name: "input-mouse-symbolic";

    Adw.PreferencesGroup interaction_group {
      Adw.ComboRow right_click_row {
        notify::selected => $right_click_selected();
      }

      Adw.SwitchRow scrollbar_row {
        notify::active => $scrollbar_toggled();
      }

      Adw.ComboRow close_confirmation_row {
        notify::selected => $close_confirmation_selected();
      }

      Adw.SwitchRow focus_follows_mouse_row {
        notify::active => $focus_follows_mouse_toggled();
      }

      Adw.SwitchRow ctrl_scroll_zoom_row {
        notify::active => $ctrl_scroll_zoom_toggled();

        [suffix]
        Gtk.Button ctrl_scroll_zoom_reset_button {
          icon-name: "edit-undo-symbolic";
          valign: center;
          clicked => $ctrl_scroll_zoom_reset_clicked();

          styles [
            "flat",
          ]
        }
      }
    }

    Adw.PreferencesGroup bell_group {
      Adw.SwitchRow bell_system_row {
        notify::active => $bell_toggled();
      }

      Adw.SwitchRow bell_audio_row {
        notify::active => $bell_toggled();
      }

      Adw.SwitchRow bell_attention_row {
        notify::active => $bell_toggled();
      }

      Adw.SwitchRow bell_title_row {
        notify::active => $bell_toggled();
      }

      Adw.SwitchRow bell_border_row {
        notify::active => $bell_toggled();
      }
    }
  }

  Adw.PreferencesPage shell_page {
    name: "shell";
    icon-name: "utilities-terminal-symbolic";

    Adw.PreferencesGroup shell_group {
      Adw.ComboRow shell_row {
        use-markup: false;
        notify::selected => $shell_selected();
      }
    }
  }

  Adw.PreferencesPage about_page {
    name: "about";
    icon-name: "help-about-symbolic";

    Adw.PreferencesGroup about_header_group {
      Gtk.Box {
        orientation: vertical;
        spacing: 6;
        halign: center;
        margin-bottom: 6;

        Gtk.Image about_logo {
          icon-name: "ghostty-gx";
          pixel-size: 112;
          margin-bottom: 6;
        }

        Gtk.Label about_name {
          use-markup: false;

          styles [
            "title-1",
          ]
        }

        Gtk.Label about_version {
          halign: center;
          use-markup: false;

          styles [
            "gx-badge",
            "gx-accent",
            "accent",
            "numeric",
          ]
        }

        Gtk.Label about_notice {
          justify: center;
          wrap: true;
          max-width-chars: 48;
          margin-top: 6;
          use-markup: false;

          styles [
            "dim-label",
          ]
        }
      }
    }

    Adw.PreferencesGroup about_group {
      Adw.ActionRow config_path_row {
        use-markup: false;
        subtitle-selectable: true;

        [suffix]
        Gtk.Button open_folder_button {
          icon-name: "folder-open-symbolic";
          valign: center;
          clicked => $open_folder_clicked();

          styles [
            "flat",
          ]
        }

        [suffix]
        Gtk.Button open_config_button {
          valign: center;
          clicked => $open_config_clicked();
        }
      }
    }

    Adw.PreferencesGroup settings_file_group {
      Adw.ActionRow settings_path_row {
        use-markup: false;
        subtitle-selectable: true;
      }
    }
  }
}

// The theme list, pushed over the pages from the theme rows of the
// appearance page. Its list model and row factory are set up in code.
Adw.NavigationPage theme_subpage {
  tag: "themes";
  shown => $theme_subpage_shown();
  hidden => $theme_subpage_hidden();

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    [top]
    Adw.Clamp {
      maximum-size: 720;

      Gtk.Box {
        orientation: vertical;
        spacing: 6;
        margin-start: 12;
        margin-end: 12;
        margin-bottom: 6;

        Gtk.Box {
          orientation: horizontal;
          spacing: 6;

          Gtk.SearchEntry theme_search {
            hexpand: true;
            search-changed => $theme_search_changed();
            activate => $theme_search_activated();
            stop-search => $theme_search_stopped();
          }

          Gtk.Button theme_revert_button {
            sensitive: false;
            clicked => $theme_revert_clicked();
          }

          Gtk.Button theme_apply_button {
            sensitive: false;
            clicked => $theme_apply_clicked();

            styles [
              "suggested-action",
            ]
          }
        }

        Gtk.Label theme_hint {
          xalign: 0;
          wrap: true;

          styles [
            "dim-label",
            "caption",
          ]
        }
      }
    }

    content: Adw.Clamp {
      maximum-size: 720;

      Gtk.Stack theme_stack {
        margin-start: 12;
        margin-end: 12;
        margin-bottom: 12;

        Gtk.StackPage {
          name: "list";

          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            vexpand: true;

            styles [
              "card",
            ]

            Gtk.ListView theme_list {
              activate => $theme_list_activated();

              styles [
                "navigation-sidebar",
              ]
            }
          };
        }

        Gtk.StackPage {
          name: "empty";

          child: Gtk.Label theme_empty {
            valign: start;
            margin-top: 24;

            styles [
              "dim-label",
            ]
          };
        }
      }
    };
  };
}
