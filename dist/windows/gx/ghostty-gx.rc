// Ghostty GX resources for ghostty.exe (fork file; src/build/GhosttyExe.zig selects it, GX-0026).
// Same manifest and icon ID as the upstream dist/windows/ghostty.rc, with the Ghostty GX icon
// (generated by scripts/gx_icon.py) and Ghostty GX version information.

// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
RT_MANIFEST 24 "../ghostty.manifest"

#define ID_ICON_GHOSTTY 1
ID_ICON_GHOSTTY ICON "ghostty-gx.ico"

// winver.h is not included: without this define the block would be a resource
// named "VS_VERSION_INFO" that GetFileVersionInfo never finds.
#define VS_VERSION_INFO 1
VS_VERSION_INFO VERSIONINFO
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        VALUE "CompanyName",      "gx0404"
        VALUE "FileDescription",  "Ghostty GX"
        VALUE "OriginalFilename", "ghostty.exe"
        VALUE "ProductName",      "Ghostty GX"
        VALUE "Comments",         "Ghostty GX is an unofficial fork of Ghostty maintained by gx0404. It is not affiliated with or endorsed by the Ghostty project."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
